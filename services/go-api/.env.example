ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_HEALTH_URL=https://<prod-host>/health

DATABASE_URL=postgresql://altune:altune_dev@localhost:5432/altune?sslmode=disable
DB_POOL_MAX_CONNS=20

SUPABASE_PROJECT_URL=https://<ref>.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

MUSICBRAINZ_USER_AGENT=altune/0.1 ( mailto:dev@altune.test )
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
FANARTTV_API_KEY=
GENIUS_ACCESS_TOKEN=
DISCOGS_TOKEN=
YOUTUBE_API_KEY=

SPOTIFY_ENABLED=true
SOUNDCLOUD_ENABLED=true
APPLEMUSIC_ENABLED=true
AMAZONMUSIC_ENABLED=true
YTMUSIC_ENABLED=true

AUDIO_PREFETCH_ENABLED=true

PLAYBACK_NOW_PLAYING_ENRICHMENT_ENABLED=true

OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_S3_BUCKET=<bucket>
OCI_S3_REGION=<region>

MUSIC_DIR=

FFMPEG_LOCATION=
YTDLP_COOKIE_FILE=
YTDLP_JS_RUNTIME=node
ACOUSTID_API_KEY=

STREAMRIP_SERVICES=
STREAMRIP_BIN=rip

OVERSEER_PRINCIPAL_ID=
EVAL_METER_ENABLED=false
ACQUISITION_PAUSED=false
DISABLED_JOBS=

GITEA_ISSUE_URL=https://altune-git.duckdns.org
GITEA_ISSUE_REPO=
GITEA_ISSUE_TOKEN=
FEEDBACK_ENABLED=true

ALERT_ZERO_RESULT_THRESHOLD=0
ALERT_WEBHOOK_URL=

BEHAVIORAL_CORPUS_PATH=

BEHAVIORAL_RANKING_ENABLED=false

EXPLORATION_ENABLED=false
EXPLORATION_RATE=0.03

TAIL_DEMOTION_ENABLED=false

CROSS_KIND_PROMINENCE_ENABLED=true

SSE_MAX_CONNS=2048
