# Copy to .env.development for local runs — that exact filename is what config.Load reads.

# Environment
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Database (Supabase or local Postgres)
# Local dev:  postgresql://altune:altune_dev@localhost:5432/altune?sslmode=disable
# Supabase:   postgresql://postgres.[ref]:[pw]@...pooler.supabase.com:5432/postgres?sslmode=require
#             Use session-mode pooler (port 5432), NOT transaction mode (port 6543).
DATABASE_URL=postgresql://altune:altune_dev@localhost:5432/altune?sslmode=disable
# Ceiling on concurrent pgx connections, sized against this service's own
# concurrency (acquisition workers + request path) rather than the host's CPU
# count. Non-positive falls back to the default.
DB_POOL_MAX_CONNS=20

# Supabase Auth (JWKS only — HS256 not supported)
SUPABASE_PROJECT_URL=https://<ref>.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# Redis (optional — caches degrade gracefully when unavailable)
REDIS_URL=redis://localhost:6379/0
# Ceiling on concurrent go-redis connections; sits above DB_POOL_MAX_CONNS
# because a request can make several short cache calls holding no DB
# connection. Past it callers queue, then fail once go-redis's PoolTimeout
# expires. Non-positive falls back to the default.
REDIS_POOL_SIZE=50

# Discovery providers (all optional — disabled when unset)
MUSICBRAINZ_USER_AGENT=altune/0.1 ( mailto:dev@altune.test )
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
FANARTTV_API_KEY=
GENIUS_ACCESS_TOKEN=
DISCOGS_TOKEN=
YOUTUBE_API_KEY=

# Kill switches for reverse-engineered providers (default true; set false to pull one)
SPOTIFY_ENABLED=true
SOUNDCLOUD_ENABLED=true
APPLEMUSIC_ENABLED=true
AMAZONMUSIC_ENABLED=true
YTMUSIC_ENABLED=true

# Remote kill switch for mobile audio prefetching (default true; false = clients only stream)
AUDIO_PREFETCH_ENABLED=true

# Kill switch for now-playing enrichment on queue resume (default true; restart to
# apply). false skips the per-resume catalog lookup; resume still returns the queue.
PLAYBACK_NOW_PLAYING_ENRICHMENT_ENABLED=true

# OCI Object Storage (S3-compatible)
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_S3_BUCKET=altune-audio
OCI_S3_REGION=ca-montreal-1

# Local audio storage fallback
MUSIC_DIR=

# Audio acquisition tools
FFMPEG_LOCATION=
YTDLP_COOKIE_FILE=
YTDLP_JS_RUNTIME=node
ACOUSTID_API_KEY=

# streamrip fetchers for catalog-resolved tracks; empty disables them.
# Comma-separated from: tidal,deezer,qobuz,soundcloud
# tidal and qobuz require a premium account configured via `rip config open`.
STREAMRIP_SERVICES=
STREAMRIP_BIN=rip

# Operator API at /admin, read by Overseer (fail-closed: denied to everyone
# unless OPERATOR_USER_ID is set to your Supabase user id).
OPERATOR_USER_ID=
# Observability API at /observe, read by Overseer: the Supabase user id (UUID) of
# Overseer's service account, the only caller admitted. Empty falls back to
# OPERATOR_READONLY_USER_ID; with both empty every /observe request gets 403.
# Must NOT equal OPERATOR_USER_ID.
OVERSEER_PRINCIPAL_ID=
# Discovery-eval meter. OFF by default — a live run hits real provider APIs and
# shares quota with user traffic. Leave false until the live runner is wired.
EVAL_METER_ENABLED=false
# Pause the background acquisition scheduler at startup. Restart to change.
ACQUISITION_PAUSED=false
# Comma-separated background job names to start disabled. Restart to change.
DISABLED_JOBS=

# In-app feedback — testers file bugs and ideas from Settings and the server
# creates the GitHub issue, so the token never ships in the app. Both must be
# set or reports are disabled. The PAT needs only `issues: write` on
# this one repo. The repo is public, and every issue body DOES publish the
# reporter's opaque user UUID (row `reporterIdentityRow` in
# internal/feedback/adapters/providers/issue_body.go), never an email, handle,
# or IP. It is kept on purpose as the locator for erasure requests: the service
# never deletes a filed issue, so removal is a manual `gh issue delete` found
# by that UUID (policy of record: internal/feedback/RETENTION.md).
GITHUB_ISSUE_REPO=
GITHUB_ISSUE_TOKEN=
# Kill switch (default true; restart to apply). false disables in-app reports
# while keeping the credentials above; submits then get 503 "feedback.disabled".
FEEDBACK_ENABLED=true

# --- Discovery telemetry & ranking experiments ------------------------------
# The behavioral loop COLLECTS by default: client engagement events, server-side
# search_performed, discovery_events persistence, and the 6h metrics rollup are
# always on. The flags below light up the parts that USE that data. Enable the
# zero-risk read side first; gate any ranking-affecting flag behind a
# discoveryeval A/B (see docs/solutions/2026-06-29-cross-kind-ranking-ties.md).

# Coverage alert — log an alert when zero-result searches in a
# 24h window exceed this count. 0 = disabled. ZERO-RISK observability; recommend a
# small value in prod (e.g. 5) so blind spots page instead of waiting to be noticed.
ALERT_ZERO_RESULT_THRESHOLD=0

# Self-growing behavioral eval corpus — when set, a nightly job materializes
# search->engagement labels (completed/library_add ⇒ +1, wrong_album ⇒ −1) to this
# JSON file in the cmd/discoveryeval corpus format. Empty = job off. ZERO ranking
# risk (write-only). Point at a writable path on the host, e.g.
# /var/lib/altune/behavioral_corpus.json.
BEHAVIORAL_CORPUS_PATH=

# Behavioral ranking — feeds the satisfaction signal (play/completed +, skip-after-
# click −) into ranking as a within-tie input. RANKING-AFFECTING: enable only after
# a discoveryeval A/B on the behavioral corpus proves it holds the existing corpora.
BEHAVIORAL_RANKING_ENABLED=false

# Exploration — randomizes result order for a small fraction of searches to seed
# unbiased propensity data for offline counterfactual eval. Small user-facing cost.
# RATE applies only when ENABLED.
EXPLORATION_ENABLED=false
EXPLORATION_RATE=0.03

# Tail-noise demotion — single-source UGC/scrobble results with no identity sort
# below corroborated ones. RANKING-AFFECTING, eval A/B-gated.
TAIL_DEMOTION_ENABLED=false

# Cross-kind prominence tiebreak — artist-intent burial fix, proven by fixture A/B
# (2026-06-29). ON by default; set false to disable.
CROSS_KIND_PROMINENCE_ENABLED=true

# Server-wide ceiling on concurrent /v1/events SSE streams across all users
# (each user is separately capped at 8). Past it new streams get 429.
# Non-positive falls back to the default.
SSE_MAX_CONNS=2048
