altune.duckdns.org {
	redir /overseer /overseer/
	handle_path /overseer/* {
		reverse_proxy altune-overseer:8090
	}

	@playlistDetail {
		path_regexp ^/library/playlist/[^/]+$
		file {
			root /srv/web/prod/current
			try_files /library/playlist/\[id\].html
		}
	}
	rewrite @playlistDetail /library/playlist/[id].html

	@web file {
		root /srv/web/prod/current
		try_files {path} {path}.html {path}/index.html
	}
	@expoHashedAsset path /_expo/static/*
	@webHtmlShell {
		not path /_expo/static/*
	}
	handle @web {
		root * /srv/web/prod/current
		rewrite * {file_match.relative}
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https: blob:; connect-src 'self' https://ellvexundmgvbbfqbzau.supabase.co wss://ellvexundmgvbbfqbzau.supabase.co https://raw.githubusercontent.com/aleburrascano/altune/main/kill-switches.json; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
		header @expoHashedAsset Cache-Control "public, max-age=31536000, immutable"
		header @webHtmlShell Cache-Control "no-cache"
		file_server
	}

	handle {
		import /etc/caddy/upstream.conf
	}
}

altune-staging.duckdns.org {
	redir /overseer /overseer/
	handle_path /overseer/* {
		reverse_proxy altune-staging-overseer:8090
	}

	@playlistDetail {
		path_regexp ^/library/playlist/[^/]+$
		file {
			root /srv/web/staging/current
			try_files /library/playlist/\[id\].html
		}
	}
	rewrite @playlistDetail /library/playlist/[id].html

	@web file {
		root /srv/web/staging/current
		try_files {path} {path}.html {path}/index.html
	}
	@expoHashedAsset path /_expo/static/*
	@webHtmlShell {
		not path /_expo/static/*
	}
	handle @web {
		root * /srv/web/staging/current
		rewrite * {file_match.relative}
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https: blob:; connect-src 'self' https://ijyjoyxhwmbmriwzazbx.supabase.co wss://ijyjoyxhwmbmriwzazbx.supabase.co https://raw.githubusercontent.com/aleburrascano/altune/main/kill-switches.json; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
		header @expoHashedAsset Cache-Control "public, max-age=31536000, immutable"
		header @webHtmlShell Cache-Control "no-cache"
		file_server
	}

	handle {
		import /etc/caddy/staging-upstream.conf
	}
}

http://:8081 {
	import /etc/caddy/upstream.conf
}

http://:8082 {
	import /etc/caddy/staging-upstream.conf
}
