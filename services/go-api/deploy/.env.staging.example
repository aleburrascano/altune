# Staging env template (epic #1488, task #1490 — design: docs/features/staging-tier/design.md).
#
# Copy to services/go-api/.env.staging ON THE VM ONLY and fill the __SET_ON_VM__
# placeholders with the staging Supabase project's real values. This file is a
# committed TEMPLATE: it holds NO secrets. Real secret values (Supabase keys, DB
# password, operator refresh-token seed, owner UUID) live only in
# ../.env.staging on the VM, never in the repo.
#
# Non-secret structural values are pre-filled for the staging Supabase project
# ref `ijyjoyxhwmbmriwzazbx` (region us-east-2) and the altune-staging.duckdns.org
# subdomain. Keys mirror .env.production so the two tiers stay in lockstep.

# Environment
ENV=staging
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS — allow the staging web/admin origin.
CORS_ORIGINS=https://altune-staging.duckdns.org

# Database — the STAGING Supabase project's session-mode pooler (port 5432, NOT
# 6543). Isolated from prod. Fill user/password/host from the staging project.
DATABASE_URL=__SET_ON_VM__

# Supabase Auth for go-api (JWKS only — staging's own auth realm).
SUPABASE_PROJECT_URL=https://ijyjoyxhwmbmriwzazbx.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_JWKS_URL=https://ijyjoyxhwmbmriwzazbx.supabase.co/auth/v1/.well-known/jwks.json
# Public client key for the staging project (served to the admin console).
SUPABASE_ANON_KEY=__SET_ON_VM__

# Operator console — the staging operator account's Supabase user id (UUID). Its
# own auth realm, so this is NOT prod's operator id (design Decision 2).
OPERATOR_USER_ID=__SET_ON_VM__

# Read-only admin principal (#1810) — the overseer service account's Supabase user
# id (UUID). Admitted on admin GETs only; every mutating admin route answers 403.
# Must NOT equal OPERATOR_USER_ID (go-api refuses to start if it does). Empty
# leaves the admin surface operator-only, which sends overseer's buckets
# source_down.
OPERATOR_READONLY_USER_ID=__SET_ON_VM__

# Redis — the staging redis container on the staging network.
REDIS_URL=redis://altune-staging-redis:6379/0

# MusicBrainz requires a contact URL or email in the user agent.
MUSICBRAINZ_USER_AGENT=altune-staging/0.1 ( mailto:dev@altune.test )

# --- Overseer (control room, served under /overseer) ------------------------
# Points at the SAME staging Supabase project so the smoke gate (#1492) exercises
# the real login + operator-token rotation path in isolation from prod.
OVERSEER_OWNER_USER_ID=__SET_ON_VM__
OVERSEER_SUPABASE_URL=https://ijyjoyxhwmbmriwzazbx.supabase.co
OVERSEER_SUPABASE_ANON_KEY=__SET_ON_VM__
# go-api base the overseer buckets read — the public staging URL, so a blue-green
# flip needs no overseer restart.
OVERSEER_GOAPI_URL=https://altune-staging.duckdns.org
OVERSEER_BASE_PATH=/overseer
OVERSEER_OCI_ENABLED=false
# The staging READ-ONLY account's Supabase sign-in (the account behind
# OPERATOR_READONLY_USER_ID, never the operator's). Overseer signs in with it on
# first boot and whenever its rotating refresh token dies, then persists the live
# refresh token to the overseer-data volume (see RUNBOOK). Read-only: go-api
# refuses this account on every mutating admin route.
OVERSEER_GOAPI_READONLY_EMAIL=__SET_ON_VM__
OVERSEER_GOAPI_READONLY_PASSWORD=__SET_ON_VM__
# Optional seed for the refresh chain; leave unset when the pair above is set.
OVERSEER_GOAPI_READONLY_REFRESH_TOKEN=
