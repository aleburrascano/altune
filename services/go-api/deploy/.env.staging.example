ENV=staging
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=__SET_ON_VM__
PUBLIC_HEALTH_URL=https://<staging-host>/health

DATABASE_URL=__SET_ON_VM__

SUPABASE_PROJECT_URL=https://<staging-ref>.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_JWKS_URL=https://<staging-ref>.supabase.co/auth/v1/.well-known/jwks.json

OVERSEER_PRINCIPAL_ID=__SET_ON_VM__

REDIS_URL=redis://altune-staging-redis:6379/0

MUSICBRAINZ_USER_AGENT=altune-staging/0.1 ( mailto:dev@altune.test )

ACQUISITION_PAUSED=false
DISABLED_JOBS=

AUDIO_KEY_PREFIX=staging/

OVERSEER_OWNER_USER_ID=__SET_ON_VM__
OVERSEER_SUPABASE_URL=https://<staging-ref>.supabase.co
OVERSEER_SUPABASE_ANON_KEY=__SET_ON_VM__
OVERSEER_GOAPI_URL=http://altune-caddy:8082
OVERSEER_BASE_PATH=/overseer
OVERSEER_OCI_ENABLED=false
OVERSEER_GOAPI_READONLY_EMAIL=__SET_ON_VM__
OVERSEER_GOAPI_READONLY_PASSWORD=__SET_ON_VM__
OVERSEER_GOAPI_READONLY_REFRESH_TOKEN=

OCI_S3_ENDPOINT=__SET_ON_VM__
OCI_S3_REGION=__SET_ON_VM__
OCI_S3_BUCKET=__SET_ON_VM__
OCI_S3_ACCESS_KEY=__SET_ON_VM__
OCI_S3_SECRET_KEY=__SET_ON_VM__
