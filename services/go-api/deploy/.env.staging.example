#
# Copy to services/go-api/.env.staging ON THE VM ONLY and fill the __SET_ON_VM__
# placeholders with the staging Supabase project's real values. This file is a
# committed TEMPLATE: it holds NO secrets. Real secret values (Supabase keys, DB
# password, operator refresh-token seed, owner UUID) live only in
# ../.env.staging on the VM, never in the repo.
#
# Infrastructure identifiers (the staging Supabase project ref, the staging
# hostname, object-storage details) are not secrets but still live only on the
# VM: replace every __SET_ON_VM__ and <staging-ref> there. Keys mirror
# .env.production so the two tiers stay in lockstep.

# Environment
ENV=staging
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS — allow the staging web/overseer origin.
CORS_ORIGINS=__SET_ON_VM__
PUBLIC_HEALTH_URL=https://<staging-host>/health

# Database — the STAGING Supabase project's session-mode pooler (port 5432, NOT
# 6543). Isolated from prod. Fill user/password/host from the staging project.
DATABASE_URL=__SET_ON_VM__

# Supabase Auth for go-api (JWKS only — staging's own auth realm).
SUPABASE_PROJECT_URL=https://<staging-ref>.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_JWKS_URL=https://<staging-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Overseer principal — the overseer service account's Supabase user id (UUID),
# the only caller admitted to GET /observe/*. Empty means every /observe
# request gets 403 (fail-closed).
OVERSEER_PRINCIPAL_ID=__SET_ON_VM__

# Redis — the staging redis container on the staging network.
REDIS_URL=redis://altune-staging-redis:6379/0

# MusicBrainz requires a contact URL or email in the user agent.
MUSICBRAINZ_USER_AGENT=altune-staging/0.1 ( mailto:dev@altune.test )

# Pause the background acquisition scheduler at startup. Restart to change.
ACQUISITION_PAUSED=false
# Comma-separated background job names to start disabled. Restart to change.
DISABLED_JOBS=

# Staging shares prod's altune-audio OCI bucket; an OCI policy lets staging's
# key write/delete only under this prefix. Every new audio ref this deploy
# writes gets it prepended, and deletes/writes outside it are refused (#3090).
# Never set this in .env.production — startup refuses to run with it there.
AUDIO_KEY_PREFIX=staging/

# --- Overseer (control room, served under /overseer) ------------------------
# Points at the SAME staging Supabase project so the smoke gate (#1492) exercises
# the real login + operator-token rotation path in isolation from prod.
OVERSEER_OWNER_USER_ID=__SET_ON_VM__
OVERSEER_SUPABASE_URL=https://<staging-ref>.supabase.co
OVERSEER_SUPABASE_ANON_KEY=__SET_ON_VM__
# go-api base the overseer buckets read — the prod Caddy's internal-only staging
# listener (Caddyfile :8082, not host-published), which imports
# staging-upstream.conf, so a blue-green flip needs no overseer restart.
OVERSEER_GOAPI_URL=http://altune-caddy:8082
OVERSEER_BASE_PATH=/overseer
OVERSEER_OCI_ENABLED=false
# The staging READ-ONLY account's Supabase sign-in (the account behind
# OVERSEER_PRINCIPAL_ID). Overseer signs in with it on
# first boot and whenever its rotating refresh token dies, then persists the live
# refresh token to the overseer-data volume. go-api admits it on
# GET /observe/* only.
OVERSEER_GOAPI_READONLY_EMAIL=__SET_ON_VM__
OVERSEER_GOAPI_READONLY_PASSWORD=__SET_ON_VM__
# Optional seed for the refresh chain; leave unset when the pair above is set.
OVERSEER_GOAPI_READONLY_REFRESH_TOKEN=

# --- Audio object storage ----------------------------------------------------
# Prod's bucket with a staging key that can only READ it, so audio synced from
# prod plays and staging can never write or delete it. New downloads fail on
# staging by design.
OCI_S3_ENDPOINT=__SET_ON_VM__
OCI_S3_REGION=__SET_ON_VM__
OCI_S3_BUCKET=__SET_ON_VM__
OCI_S3_ACCESS_KEY=__SET_ON_VM__
OCI_S3_SECRET_KEY=__SET_ON_VM__
