#!/usr/bin/env sh

pushing=0
while read -r _ local_sha _ _; do
  case $local_sha in
    *[!0]*) pushing=1 ;;
  esac
done
[ $pushing = 1 ] || exit 0

echo "pre-push: checking this checkout (HEAD and the working tree) against the merge base, not the refs being pushed"
rc=0
[ -f scripts/precheck.sh ] && { env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE CLIENT_MUTATE_RUNS_ELSEWHERE=1 bash scripts/precheck.sh || rc=$?; }
case $rc in
  0) ;;
  3) echo "❌ pre-push: a tool or dependency is missing, so some checks could not run (see the SKIP lines above). Install it, then push again: bash scripts/ci/go-tools.sh for golangci-lint and govulncheck, bash scripts/worktree-deps.sh client (or the folder named) for node dependencies."; exit 1 ;;
  *) echo "❌ pre-push: checks failed. Fix the FAIL lines above and push again."; exit 1 ;;
esac

exit 0
