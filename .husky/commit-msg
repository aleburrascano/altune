#!/usr/bin/env sh

MSG_FILE="$1"

if [ -f "$MSG_FILE" ]; then
  PYTHON=""
  for candidate in python3 python; do
    if "$candidate" -c "" >/dev/null 2>&1; then
      PYTHON="$candidate"
      break
    fi
  done
  if [ -n "$PYTHON" ]; then
    "$PYTHON" - "$MSG_FILE" <<'PYEOF'
import re, sys, pathlib

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

patterns = [
    r'(?im)^Co-Authored-By:.*(Claude|Anthropic|AI|🤖).*$\n?',
    r'(?im)^\s*🤖.*Generated.*$\n?',
    r'(?im)^.*Generated with.*Claude Code.*$\n?',
    r'(?im)^.*Generated with.*Anthropic.*$\n?',
]
for p in patterns:
    text = re.sub(p, '', text)

# Collapse 3+ consecutive blank lines to 2
text = re.sub(r'\n{3,}', '\n\n', text)
path.write_text(text, encoding="utf-8")
PYEOF
  fi
fi

if [ -d node_modules/@commitlint ]; then
  if ! npx --no -- commitlint --edit "$MSG_FILE"; then
    echo "commitlint: the header is type(scope): subject, at most 72 characters in all, with an all lower-case subject (no capitals, CamelCase identifiers or acronyms); type and scope come from commitlint.config.js, e.g. tooling(tooling): precheck names failed jest tests" >&2
    exit 1
  fi
fi
