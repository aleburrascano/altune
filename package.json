{
  "name": "altune",
  "version": "0.0.0",
  "private": true,
  "description": "Altune — music manager. Repo root: git-hook and repo tooling only. The mobile app is a standalone npm package under client (see ADR-0016); the Go service lives under services/go-api.",
  "scripts": {
    "prepare": "husky",
    "cycles": "graft build && node scripts/check-cycles.mjs",
    "dev:up": "docker compose -f services/go-api/deploy/compose.dev.yml up -d",
    "dev:down": "docker compose -f services/go-api/deploy/compose.dev.yml down",
    "dev:reset": "docker compose -f services/go-api/deploy/compose.dev.yml down -v"
  },
  "devDependencies": {
    "@nanonets/graft": "0.18.0",
    "husky": "^9.1.6",
    "js-yaml": "4.3.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
