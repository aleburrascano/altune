{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.sh\"",
            "timeout": 90,
            "statusMessage": "Checking the edited file"
          }
        ]
      }
    ]
  }
}
