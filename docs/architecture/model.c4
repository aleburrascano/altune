specification {
  element person { style { shape person } }
  element system
  element external { style { color muted } }
  element container
  element mobile { style { shape mobile } }
  element browser { style { shape browser } }
  element database { style { shape storage } }

  deploymentNode cloud
  deploymentNode vm
  deploymentNode project
  deploymentNode device
}

model {
  listener = person 'Listener' 'Discovers, saves and streams music they own. Installs the app by sideloading through AltStore or SideStore.'
  owner = person 'Owner' 'Runs Altune. The only account allowed into Overseer.'

  altune = system 'Altune' {
    description 'Self-hosted music manager: discover music across providers, build a library you own, stream it.'

    app = mobile 'Mobile app' {
      technology 'Expo, React Native, TypeScript'
      description 'Discover, library, playlists and playback. Keeps offline downloads and a telemetry outbox.'
    }
    proxy = container 'Reverse proxy' {
      technology 'Caddy 2'
      description 'Terminates TLS. Routes /overseer/* to Overseer and everything else to the live API colour.'
    }
    api = container 'API' {
      technology 'Go, hexagonal modular monolith'
      description 'Discovery, catalog, library, Acquisition, playback and feedback. Runs as blue and green copies, one live.'
    }
    cache = database 'Cache' {
      technology 'Redis 7, no persistence'
      description 'Discovery results, enrichment, artwork and identity caches.'
    }
    db = database 'Database' {
      technology 'Postgres, Supabase session pooler'
      description 'System of record: catalog, library, playlists.'
    }
    audio = database 'Audio store' {
      technology 'OCI Object Storage, S3 API'
      description 'Acquired audio files.'
    }
    overseerUi = browser 'Overseer dashboard' {
      technology 'React, Vite'
      description 'Owner-only control room panels. Served by Overseer.'
    }
    overseer = container 'Overseer' {
      technology 'Go'
      description 'Watches the API: health, performance, cost, quality, logs, security probes. Kept independent so it survives API restarts.'
    }

    app -> proxy 'Calls the API and streams audio' {
      technology 'HTTPS/JSON, SSE'
    }
    overseerUi -> proxy 'Loads buckets and live stream' {
      technology 'HTTPS/JSON, SSE'
    }
    proxy -> api 'Forwards API and /admin traffic to the live colour' {
      technology 'HTTP'
    }
    proxy -> overseer 'Forwards /overseer/*' {
      technology 'HTTP'
    }
    api -> db 'Reads and writes' {
      technology 'Postgres protocol'
    }
    api -> cache 'Caches discovery lookups' {
      technology 'RESP'
    }
    api -> audio 'Stores and reads audio, signs download URLs' {
      technology 'S3 API'
    }
    app -> audio 'Downloads audio for offline play' {
      technology 'HTTPS, presigned URLs'
    }
    overseer -> proxy 'Reads /admin health, metrics, logs and events via the public URL' {
      technology 'HTTPS/JSON, SSE'
    }
  }

  supabaseAuth = external 'Supabase Auth' 'Identity: sign-in, OAuth, JWTs and JWKS.'
  providers = external 'Music providers' 'Search, metadata, artwork, charts and lyrics: MusicBrainz, Cover Art Archive, Deezer, iTunes, Last.fm, Discogs, SoundCloud, YouTube Music, Genius, Fanart.tv, TheAudioDB. Spotify, Apple Music and Amazon Music behind flags.'
  audioSources = external 'Audio sources' 'Where Acquisition downloads audio: YouTube and SoundCloud via yt-dlp, and Tidal, Qobuz or Deezer via streamrip when enabled.'
  acoustid = external 'AcoustID' 'Audio fingerprint lookup to verify acquired tracks.'
  github = external 'GitHub' 'Feedback becomes issues. Hosts the kill-switch file and the AltStore source.'
  ntfy = external 'ntfy' 'Push alerts to the owner.'
  ociUsage = external 'OCI Usage API' 'Tenancy cost data.'

  altune -> supabaseAuth 'Authenticates users and the owner'
  altune -> github 'Files feedback, reads kill switches'

  listener -> altune.app 'Uses'
  owner -> altune.overseerUi 'Monitors Altune'

  altune.app -> supabaseAuth 'Signs in' {
    technology 'HTTPS, supabase-js'
  }
  altune.app -> github 'Polls kill switches' {
    technology 'HTTPS, raw file'
  }
  altune.overseerUi -> supabaseAuth 'Signs the owner in' {
    technology 'HTTPS, supabase-js'
  }
  altune.api -> supabaseAuth 'Verifies JWTs' {
    technology 'HTTPS, JWKS'
  }
  altune.api -> providers 'Searches and enriches' {
    technology 'HTTPS/JSON'
  }
  altune.api -> audioSources 'Acquires audio' {
    technology 'yt-dlp, streamrip'
  }
  altune.api -> acoustid 'Verifies fingerprints' {
    technology 'HTTPS, chromaprint'
  }
  altune.api -> github 'Files feedback as issues' {
    technology 'HTTPS, GitHub API'
  }
  altune.api -> ntfy 'Sends alerts' {
    technology 'HTTPS'
  }
  altune.overseer -> supabaseAuth 'Verifies the owner, refreshes its read-only token' {
    technology 'HTTPS, JWKS'
  }
  altune.overseer -> ociUsage 'Reads cost' {
    technology 'OCI SDK, instance principal'
  }
}

deployment {
  iphone = device 'iPhone' {
    description 'Sideloaded build. Talks to prod only: the API URL is baked in at release.'
    app = instanceOf altune.app
  }

  oci = cloud 'Oracle Cloud' {
    host = vm 'VM' {
      description 'The one VM. altune.duckdns.org and altune-staging.duckdns.org both point here.'
      technology 'Docker Compose'

      caddy = instanceOf altune.proxy 'Caddy' {
        description 'Shared edge for both environments. Routes each hostname to its own stack.'
      }

      prod = project 'Prod stack' {
        technology 'Compose project go-api'
        api = instanceOf altune.api 'API, blue and green'
        overseer = instanceOf altune.overseer
        cache = instanceOf altune.cache
      }

      staging = project 'Staging stack' {
        technology 'Compose project staging, CPU and memory capped'
        api = instanceOf altune.api 'API, blue and green'
        overseer = instanceOf altune.overseer
        cache = instanceOf altune.cache
      }
    }

    objectStorage = project 'Object Storage' {
      prodAudio = instanceOf altune.audio 'Audio bucket, prod'
      stagingAudio = instanceOf altune.audio 'Audio bucket, staging' {
        description 'Own bucket and bucket-scoped key (#1539). Objects expire after 7 days.'
      }
    }
  }

  supabase = cloud 'Supabase' {
    prodProject = project 'Prod project' {
      db = instanceOf altune.db
    }
    stagingProject = project 'Staging project' {
      description 'Own auth realm and data.'
      db = instanceOf altune.db
    }
  }
}

views {
  view context {
    title 'Level 1: System context'
    include *
  }
  deployment view deployment {
    title 'Level 2: Deployment, prod and staging'
    include
      iphone.**,
      oci.**,
      supabase.**
    exclude
      oci.host.prod.** -> supabase.stagingProject.**,
      oci.host.staging.** -> supabase.prodProject.**,
      oci.host.prod.** -> oci.objectStorage.stagingAudio,
      oci.host.staging.** -> oci.objectStorage.prodAudio,
      iphone.** -> oci.objectStorage.stagingAudio
    autoLayout LeftRight
  }
  view containers of altune {
    title 'Level 2: Containers'
    include *
    autoLayout LeftRight
  }
}
