{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "clearTextReporter": { "maxTestsToLog": 0 },
  "tempDirName": "../../.stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 4,
  "timeoutMS": 20000,
  "disableTypeChecks": true,
  "mutate": ["src/shared/events/**/*.ts", "!src/shared/events/**/__tests__/**", "src/shared/playback/**/*.ts", "!src/shared/playback/**/__tests__/**", "src/shared/offline/**/*.ts", "!src/shared/offline/**/__tests__/**", "src/shared/api-client/**/*.ts", "!src/shared/api-client/**/__tests__/**", "src/shared/lib/**/*.ts", "!src/shared/lib/**/__tests__/**", "src/shared/telemetry/**/*.ts", "!src/shared/telemetry/**/__tests__/**", "src/shared/auth/**/*.ts", "!src/shared/auth/**/__tests__/**"],
  "thresholds": { "high": 90, "low": 80, "break": 93 },
  "ignorePatterns": [".expo", "android", "ios", "reports", "coverage"]
}
