{
  "expo": {
    "name": "Altune",
    "slug": "altune",
    "version": "0.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://altune.duckdns.org/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/ota-certificate.crt",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "orientation": "portrait",
    "scheme": "altune",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altune.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.altune.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "ALTAppGroups": [
          "group.com.altune.app"
        ]
      }
    },
    "android": {
      "package": "com.altune.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "inlineModules": {
        "watchedDirectories": [
          "modules/altune-widget/ios"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b7654c7-6eb5-4ba8-8e26-737b70862306"
      }
    }
  }
}
