{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "extends": ["./knip.json"],
  "ignorePatterns": ["**/*.test.{ts,tsx}", "**/__tests__/**", "**/__mocks__/**", "jest/**"],
  "ignoreDependencies": [
    "react-doctor",
    "shaka-player",
    "expo-audio",
    "react-native-web",
    "fast-check",
    "@faker-js/faker",
    "fishery",
    "@bacons/apple-targets"
  ],
  "ignoreUnresolvedImports": ["@react-navigation/bottom-tabs"],
  "framework": [
    {
      "name": "lint-tooling-config",
      "enablers": ["@typescript-eslint/parser", "@typescript-eslint/eslint-plugin"],
      "configPatterns": ["eslint.config.js"],
      "toolingDependencies": [
        "@typescript-eslint/parser",
        "@typescript-eslint/eslint-plugin",
        "glob"
      ]
    }
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error"
  }
}
