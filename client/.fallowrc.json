{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "doctor.config.ts",
    "fingerprint.config.js",
    "scripts/**/*.mjs",
    "eslint-rules/**/*.js"
  ],
  "ignorePatterns": ["**/*.test.{ts,tsx}", "**/__tests__/**", "**/__mocks__/**", "jest/**"],
  "ignoreDependencies": [
    "react-doctor",
    "expo-updates",
    "shaka-player",
    "expo-audio",
    "react-native-web",
    "fast-check",
    "@stryker-mutator/core",
    "@stryker-mutator/jest-runner",
    "@faker-js/faker",
    "fishery"
  ],
  "dynamicallyLoaded": ["eslint/consistency/*.js"],
  "ignoreUnresolvedImports": ["@react-navigation/bottom-tabs"],
  "framework": [
    {
      "name": "lint-tooling-config",
      "enablers": ["@typescript-eslint/parser", "@typescript-eslint/eslint-plugin"],
      "configPatterns": ["eslint.config.js"],
      "toolingDependencies": [
        "@typescript-eslint/parser",
        "@typescript-eslint/eslint-plugin",
        "glob"
      ]
    }
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "circular-dependencies": "error",
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      { "name": "app", "patterns": ["src/app/**", "src/chrome/**"] },
      { "name": "feature-auth", "patterns": ["src/features/auth/**"] },
      { "name": "feature-detail", "patterns": ["src/features/detail/**"] },
      { "name": "feature-discover", "patterns": ["src/features/discovery/**"] },
      { "name": "feature-library", "patterns": ["src/features/library/**"] },
      { "name": "feature-playback", "patterns": ["src/features/playback/**"] },
      { "name": "feature-settings", "patterns": ["src/features/settings/**"] },
      { "name": "shared-acquisition", "patterns": ["src/shared/acquisition/**"] },
      { "name": "shared-apiClient", "patterns": ["src/shared/apiClient/**"] },
      { "name": "shared-auth", "patterns": ["src/shared/auth/**"] },
      { "name": "shared-timing", "patterns": ["src/shared/timing/**"] },
      { "name": "shared-errors", "patterns": ["src/shared/failure/errors.ts"] },
      { "name": "shared-events", "patterns": ["src/shared/events/**"] },
      { "name": "shared-failure", "patterns": ["src/shared/failure/**"] },
      { "name": "shared-device", "patterns": ["src/shared/device/**"] },
      { "name": "shared-files", "patterns": ["src/shared/files/**"] },
      { "name": "shared-killSwitch", "patterns": ["src/shared/killSwitch/**"] },
      { "name": "shared-lifecycle", "patterns": ["src/shared/lifecycle/**"] },
      { "name": "shared-navigation", "patterns": ["src/shared/navigation/**"] },
      { "name": "shared-offline", "patterns": ["src/shared/offline/**"] },
      { "name": "shared-playback", "patterns": ["src/shared/playback/**"] },
      { "name": "shared-playlists", "patterns": ["src/shared/playlists/**"] },
      { "name": "shared-query", "patterns": ["src/shared/query/**"] },
      { "name": "shared-session", "patterns": ["src/shared/session/**"] },
      { "name": "shared-telemetry", "patterns": ["src/shared/telemetry/**"] },
      { "name": "shared-ui", "patterns": ["src/shared/ui/**"] }
    ],
    "rules": [
      {
        "from": "app",
        "allow": [
          "feature-auth",
          "feature-detail",
          "feature-discover",
          "feature-library",
          "feature-playback",
          "feature-settings",
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-auth",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-detail",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-discover",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-library",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-playback",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "feature-settings",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-events",
          "shared-failure",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-navigation",
          "shared-offline",
          "shared-playback",
          "shared-playlists",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "shared-acquisition",
        "allow": [
          "shared-apiClient",
          "shared-errors",
          "shared-query",
          "shared-session",
          "shared-telemetry",
          "shared-ui"
        ]
      },
      {
        "from": "shared-apiClient",
        "allow": ["shared-auth", "shared-timing", "shared-device", "shared-errors"]
      },
      {
        "from": "shared-auth",
        "allow": [
          "shared-timing",
          "shared-errors",
          "shared-offline",
          "shared-session",
          "shared-telemetry"
        ]
      },
      { "from": "shared-timing", "allow": [] },
      { "from": "shared-errors", "allow": [] },
      {
        "from": "shared-events",
        "allow": [
          "shared-acquisition",
          "shared-apiClient",
          "shared-auth",
          "shared-errors",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-offline",
          "shared-query",
          "shared-session",
          "shared-telemetry"
        ]
      },
      { "from": "shared-failure", "allow": ["shared-errors"] },
      { "from": "shared-files", "allow": [] },
      {
        "from": "shared-killSwitch",
        "allow": ["shared-timing", "shared-files", "shared-lifecycle"]
      },
      { "from": "shared-lifecycle", "allow": [] },
      { "from": "shared-navigation", "allow": ["shared-apiClient", "shared-session"] },
      {
        "from": "shared-offline",
        "allow": [
          "shared-apiClient",
          "shared-timing",
          "shared-device",
          "shared-errors",
          "shared-files",
          "shared-killSwitch",
          "shared-session",
          "shared-telemetry"
        ]
      },
      { "from": "shared-playback", "allow": ["shared-apiClient", "shared-device"] },
      {
        "from": "shared-playlists",
        "allow": [
          "shared-apiClient",
          "shared-errors",
          "shared-failure",
          "shared-query",
          "shared-session",
          "shared-ui"
        ]
      },
      {
        "from": "shared-query",
        "allow": [
          "shared-apiClient",
          "shared-errors",
          "shared-session",
          "shared-telemetry",
          "shared-timing",
          "shared-ui"
        ]
      },
      { "from": "shared-session", "allow": [] },
      {
        "from": "shared-telemetry",
        "allow": [
          "shared-apiClient",
          "shared-device",
          "shared-errors",
          "shared-files",
          "shared-killSwitch",
          "shared-lifecycle",
          "shared-session",
          "shared-timing"
        ]
      },
      { "from": "shared-ui", "allow": ["shared-files", "shared-telemetry"] }
    ]
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 12
  }
}
